# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite for local zero-dependency out-of-the-box, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://kit_user:kit_password@localhost:5432/kit_helping_hand?schema=public"

# Authentication & Session Security
JWT_SECRET=kit_helping_hand_academic_platform_jwt_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_DIR=./storage_vault
MAX_FILE_SIZE_MB=25

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:5173

# Initial Super Admin Provisioning (Used only during first-time database initialization)
INITIAL_ADMIN_EMAIL=admin@kit.edu.pk
INITIAL_ADMIN_PASSWORD=AdminKit@2025!
INITIAL_ADMIN_NAME="KIT System Administrator"
