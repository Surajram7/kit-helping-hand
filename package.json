{
  "name": "kit-helping-hand",
  "version": "1.0.0",
  "private": true,
  "description": "KIT Helping Hand — Academic Resource Platform for Khanpur Institute of Technology",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "node server/dist/index.js",
    "postinstall": "npm run prisma:generate --workspace=server",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
